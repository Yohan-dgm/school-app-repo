{
  "expo": {
    "name": "School App",
    "slug": "school-app",
    "scheme": "school-app",
    "version": "1.1.5",
    "orientation": "default",
    "icon": "src/assets/SchooSnap_logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "notification": {
      "icon": "./src/assets/icon.png",
      "color": "#7c2d3e",
      "iosDisplayInForeground": true,
      "androidMode": "default"
    },
    "splash": {
      "image": "src/assets/SchooSnap_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false,
        "UIStatusBarStyle": "UIStatusBarStyleDefault",
        "NSPhotoLibraryUsageDescription": "Allowing access to your photo library enables you to share photos and documents with your school, such as profile pictures and academic work.",
        "NSCameraUsageDescription": "Allowing camera access enables you to take profile pictures and scan school-related QR codes.",
        "UIApplicationSupportsIndirectInputEvents": true,
        "UIBackgroundModes": ["remote-notification"],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        },
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "29",
      "bundleIdentifier": "lk.toyar.schoolapp"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "src/assets/SchooSnap_logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "lk.toyar.schoolapp",
      "versionCode": 513,
      "compileSdkVersion": 35,
      "targetSdkVersion": 35,
      "minSdkVersion": 21,
      "buildToolsVersion": "35.0.0",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.VIBRATE",
        "android.permission.CAMERA",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK",
        "com.google.android.c2dm.permission.RECEIVE"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "softwareKeyboardLayoutMode": "pan",
      "statusBarStyle": "dark-content",
      "statusBarTranslucent": true,
      "navigationBarStyle": "dark-content",
      "navigationBarColor": "#ffffff",
      "navigationBarTranslucent": true,
      "enableEdgeToEdge": true,
      "allowBackup": false,
      "blocksScreenshots": true,
      "usesCleartextTraffic": false,
      "networkSecurityConfig": "@xml/network_security_config"
    },
    "app_logo": {
      "favicon": "src/assets/SchooSnap_logo.png"
    },
    "web": {
      "favicon": "src/assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-navigation-bar",
      [
        "expo-notifications",
        {
          "icon": "./src/assets/icon.png",
          "color": "#7c2d3e"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allowing access to your photo library enables you to share photos and documents with your school, such as profile pictures and academic work.",
          "cameraPermission": "Allowing camera access enables you to take profile pictures and scan school-related QR codes.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow School App to save images to your photo library.",
          "savePhotosPermission": "Allow School App to save downloaded images to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "expo-navigation-bar": {},
      
      "eas": {
        "projectId": "c497b33a-59ce-4ea9-ae5a-ca16190babdd"
      }
    },
    "owner": "yohan.dgm"
  }
}
